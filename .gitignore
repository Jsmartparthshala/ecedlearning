# Generated by dev/video-server/serve.js — contains the laptop LAN address
# of whoever last ran it, and is regenerated at every venue.
dev/video-server/local_videos.sql
# Same generator, same reason: rehost.sql carries the current quick-tunnel
# hostname, which is different every time the tunnel starts. The logs and the
# hostname note are run artefacts of one session on one machine.
dev/video-server/rehost.sql
dev/video-server/server.log
dev/video-server/tunnel.log
dev/video-server/tunnel_host.txt

# Packaged demo builds
dist/

# Downloaded binary, not source
dev/video-server/cloudflared.exe

# Generated from the operator's own video library by make-thumbs.js.
dev/video-server/thumbs/
