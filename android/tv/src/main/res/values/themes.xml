<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Leanback provides the focus/scroll behaviour for free. Do not re-implement
         the geometric focus engine from the HTML prototype — that was a browser
         workaround and Leanback does it natively and better. -->
    <style name="Theme.Eced.Tv" parent="Theme.Leanback">
        <item name="android:windowBackground">@color/tv_bg</item>
        <item name="android:colorBackground">@color/tv_bg</item>
        <item name="android:colorPrimary">@color/brand_navy</item>
        <item name="android:colorAccent">@color/brand_navy</item>
        <item name="rowHeaderStyle">@style/EcedRowHeader</item>
    </style>

    <!-- Row headings on the browse screen.

         Leanback sets these at 20sp in the title colour, which on the old dark
         ground was a heading and on cream reads as a second, competing title
         above every row. Set as a section label instead - the same treatment
         PaneHeading gives the headings on every other screen - so the rows are
         labelled without the labels outranking the content.

         The colour has to be stated here rather than left to the text appearance,
         because Widget.Leanback.Row.Header carries one that resolves to white. -->
    <style name="EcedRowHeader" parent="Widget.Leanback.Row.Header">
        <item name="android:textColor">@color/tv_muted</item>
        <item name="android:textSize">@dimen/text_label</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.12</item>
    </style>

    <style name="Theme.Eced.Player" parent="Theme.Leanback">
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <!-- Confirmation panels. GuidedStepSupportFragment needs a GuidedStep theme,
         and the activities hosting it are plain Theme.Leanback, so ConfirmFragment
         supplies this through onProvideTheme() rather than the manifest.

         This exists because AppCompat's AlertDialog cannot work here at all: it
         requires the activity theme to descend from Theme.AppCompat, and every
         activity in this app is Leanback. Building one threw the moment a teacher
         pressed OK, which on a television looks exactly like a dead button. -->
    <style name="Theme.Eced.GuidedStep" parent="Theme.Leanback.GuidedStep">
        <item name="android:colorPrimary">@color/brand_navy</item>
        <item name="android:colorAccent">@color/brand_navy</item>

        <!-- Cream question on the left, navy answers on the right - the same
             division the rest of the app makes between a page and its rail.

             Leanback resolves guidedStepBackground from ?android:colorBackground,
             and this theme descends from Theme.Leanback.GuidedStep rather than
             from Theme.Eced.Tv, so it never saw the app's own background and the
             panel came up in stock platform charcoal. Setting both: the attribute
             for the framework, colorBackground for anything that reads it
             directly. -->
        <item name="android:colorBackground">@color/tv_bg</item>
        <item name="guidedStepBackground">@color/tv_bg</item>
        <item name="guidedActionsBackground">@color/brand_navy_deep</item>
        <item name="guidedActionsBackgroundDark">@color/brand_navy_deep</item>
        <item name="guidedActionsSelectorDrawable">@drawable/guided_action_selector</item>

        <item name="guidanceTitleStyle">@style/EcedGuidanceTitle</item>
        <item name="guidanceDescriptionStyle">@style/EcedGuidanceDescription</item>
        <item name="guidanceBreadcrumbStyle">@style/EcedGuidanceBreadcrumb</item>
        <item name="guidedActionItemTitleStyle">@style/EcedGuidedActionTitle</item>
    </style>

    <style name="EcedGuidanceTitle" parent="Widget.Leanback.GuidanceTitleStyle">
        <item name="android:textColor">@color/tv_ink</item>
    </style>

    <!-- 14sp is Leanback's default and it is a phone number, not a television
         one. This is the sentence that explains what a teacher is about to do to
         their own device, so it goes to the same 18sp every other explanatory
         line in the app uses. -->
    <style name="EcedGuidanceDescription" parent="Widget.Leanback.GuidanceDescriptionStyle">
        <item name="android:textColor">@color/tv_muted</item>
        <item name="android:textSize">@dimen/text_label</item>
    </style>

    <style name="EcedGuidanceBreadcrumb" parent="Widget.Leanback.GuidanceBreadcrumbStyle">
        <item name="android:textColor">@color/text_on_surface_accent</item>
    </style>

    <!-- Cream on navy, 7.61:1, because the actions panel is now navy. -->
    <style name="EcedGuidedActionTitle" parent="Widget.Leanback.GuidedActionItemTitleStyle">
        <item name="android:textColor">@color/tv_bg</item>
        <item name="android:textSize">@dimen/text_body</item>
    </style>

    <!-- Status chip: flat pill, no elevation, no gradient. -->
    <style name="StatusChip">
        <item name="android:layout_marginStart">10dp</item>
        <item name="android:paddingHorizontal">14dp</item>
        <item name="android:paddingVertical">6dp</item>
        <item name="android:background">@drawable/chip_bg</item>
        <item name="android:textColor">@color/tv_muted</item>
        <item name="android:textSize">@dimen/text_label</item>
        <item name="android:maxLines">1</item>
    </style>

    <!--  settings -->
    <!-- Focusable on purpose, even though the contents are read-only. See
         panel_focusable_bg: without it the only focusable thing on the screen is
         the ScrollView, and the remote has nothing to move between. -->
    <style name="SettingsCard">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">10dp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">22dp</item>
        <item name="android:background">@drawable/panel_focusable_bg</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">true</item>
    </style>

    <style name="SettingsCardTitle">
        <item name="android:duplicateParentState">true</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">16dp</item>
        <item name="android:textColor">@color/text_on_surface_accent</item>
        <item name="android:textSize">@dimen/text_label</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.09</item>
    </style>

    <style name="SettingsLabel">
        <item name="android:duplicateParentState">true</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:textColor">@color/text_on_surface_muted</item>
        <item name="android:textSize">@dimen/text_label</item>
        <item name="android:letterSpacing">0.05</item>
    </style>

    <style name="SettingsValue">
        <item name="android:duplicateParentState">true</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textColor">@color/text_on_surface</item>
        <item name="android:textSize">@dimen/text_body</item>
    </style>

    <style name="SettingsValueMono" parent="SettingsValue">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">@dimen/text_label</item>
    </style>

    <style name="SettingsValueStrong" parent="SettingsValue">
        <item name="android:textColor">@color/text_on_surface_accent</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">@dimen/text_body</item>
    </style>

    <style name="SettingsNote">
        <item name="android:duplicateParentState">true</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">18dp</item>
        <item name="android:textColor">@color/text_on_surface_muted</item>
        <item name="android:textSize">@dimen/text_label</item>
        <item name="android:lineSpacingMultiplier">1.25</item>
    </style>

    <!-- A focusable settings action. Same gold-stroke focus language as every
         other focusable thing in the app, so a teacher recognises it. -->
    <!-- Deliberately not row_bg, which is what a read-only panel wears. See
         action_bg for why the two had to stop looking the same. -->
    <style name="SettingsAction">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingHorizontal">22dp</item>
        <item name="android:paddingVertical">13dp</item>
        <item name="android:background">@drawable/action_bg</item>
        <item name="android:textColor">@color/text_on_surface</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">true</item>
    </style>

    <style name="PaneHeading">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:textColor">@color/tv_muted</item>
        <item name="android:textSize">@dimen/text_label</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.12</item>
    </style>
</resources>
