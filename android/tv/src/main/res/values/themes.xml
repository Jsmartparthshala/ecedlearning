<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Leanback provides the focus/scroll behaviour for free. Do not re-implement
         the geometric focus engine from the HTML prototype — that was a browser
         workaround and Leanback does it natively and better. -->
    <style name="Theme.Eced.Tv" parent="Theme.Leanback">
        <item name="android:windowBackground">@color/tv_bg</item>
        <item name="android:colorBackground">@color/tv_bg</item>
        <item name="android:colorPrimary">@color/focus_gold</item>
        <item name="android:colorAccent">@color/focus_gold</item>
    </style>

    <style name="Theme.Eced.Player" parent="Theme.Leanback">
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <!-- Status chip: flat pill, no elevation, no gradient. -->
    <style name="StatusChip">
        <item name="android:layout_marginStart">10dp</item>
        <item name="android:paddingHorizontal">14dp</item>
        <item name="android:paddingVertical">6dp</item>
        <item name="android:background">@drawable/chip_bg</item>
        <item name="android:textColor">@color/tv_muted</item>
        <item name="android:textSize">14sp</item>
        <item name="android:maxLines">1</item>
    </style>

    <!--  settings -->
    <style name="SettingsCard">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">10dp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">22dp</item>
        <item name="android:background">@drawable/panel_bg</item>
    </style>

    <style name="SettingsCardTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">16dp</item>
        <item name="android:textColor">@color/focus_gold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.09</item>
    </style>

    <style name="SettingsLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:textColor">@color/tv_muted</item>
        <item name="android:textSize">13sp</item>
        <item name="android:letterSpacing">0.05</item>
    </style>

    <style name="SettingsValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textColor">@color/tv_ink</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="SettingsValueMono" parent="SettingsValue">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="SettingsValueStrong" parent="SettingsValue">
        <item name="android:textColor">@color/focus_gold</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="SettingsNote">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">18dp</item>
        <item name="android:textColor">@color/tv_muted</item>
        <item name="android:textSize">13sp</item>
        <item name="android:lineSpacingMultiplier">1.25</item>
    </style>

    <style name="PaneHeading">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:textColor">@color/tv_muted</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.12</item>
    </style>
</resources>
