<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Leanback provides the focus/scroll behaviour for free. Do not re-implement
         the geometric focus engine from the HTML prototype — that was a browser
         workaround and Leanback does it natively and better. -->
    <style name="Theme.Eced.Tv" parent="Theme.Leanback">
        <item name="android:windowBackground">@color/tv_bg</item>
        <item name="android:colorPrimary">@color/focus_gold</item>
        <item name="android:colorAccent">@color/focus_gold</item>
    </style>

    <style name="Theme.Eced.Player" parent="Theme.Leanback">
        <item name="android:windowBackground">@android:color/black</item>
    </style>
</resources>
