<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Overscan. Older TVs and cheap boxes crop the edges of the panel; anything
         inside 5% of the border may simply not be visible in a classroom. Leanback
         defaults assume this, custom layouts do not. -->
    <dimen name="overscan_horizontal">48dp</dimen>
    <dimen name="overscan_vertical">27dp</dimen>

    <dimen name="focus_ring_width">4dp</dimen>
    <dimen name="card_width">280dp</dimen>
    <dimen name="card_height">158dp</dimen>   <!-- 16:9 -->

    <!-- 10-foot type. Anything under 18sp is unreadable across a classroom.

         The rule was already written here and then broken everywhere: the token
         block itself defined a 16sp caption, no layout referenced any of these
         three names, and sixteen hardcoded sizes ran down to 10sp. A five year
         old at the back of a classroom cannot read 10sp on a 32 inch panel from
         three metres, so that text was not small - it was absent.

         Five steps, and 18sp is a floor rather than a suggestion. Where a badge
         could not fit its text at 18sp the badge came off the tile instead of
         the type coming down; a floor with exceptions is not a floor. -->
    <dimen name="text_display">44sp</dimen>
    <dimen name="text_title">32sp</dimen>
    <dimen name="text_heading">24sp</dimen>
    <dimen name="text_body">20sp</dimen>
    <dimen name="text_label">18sp</dimen>

    <!-- Unit rail. Sized so six units sit inside the overscan padding without the sixth
         being clipped, which is what tells a teacher the rail scrolls. -->
    <dimen name="unit_tile_width">132dp</dimen>
    <dimen name="unit_tile_height">76dp</dimen>

    <!-- Lesson poster. The grid runs four columns inside the overscan padding,
         giving a 207dp column; 116dp of artwork keeps that at 16:9 so real
         thumbnails can replace the flat fill later without a relayout.

         It was five columns and a 161dp poster, which is the reason the title
         underneath was set at 15sp: nothing larger fitted. Widening the column
         is what buys the type its floor - the poster is the densest thing in
         the app and it set the ceiling for everything else. -->
    <dimen name="poster_art_height">116dp</dimen>
    <dimen name="grid_gap">12dp</dimen>
    <dimen name="focus_bleed">6dp</dimen>

    <!-- Insets for the Downloads and Settings screens. Plain overscan now that
         they are activities rather than fragments inside Leanback's scale_frame. -->
    <dimen name="page_content_start">@dimen/overscan_horizontal</dimen>
    <!-- Measure for body copy on the prose pages. Profile capped its paragraph
         and Downloads did not, so the same sentence set at the same size read as
         two different pages: one a column, the other a single line stretched
         across seventeen hundred pixels, which the eye cannot track back to the
         start of. -->
    <dimen name="page_measure">620dp</dimen>
    <dimen name="page_content_top">0dp</dimen>

    <!-- Subject tiles. The first choice a teacher makes on the screen, so this is
         the one tile sized around its words rather than around how many fit.

         200dp carries "ECED English" on one line at 24sp, which is what the
         subject name is worth; 168dp did not, which is why the name sat at 21sp
         and the Nepali under it at 14sp. Four now sit inside the usable width
         with the fifth peeking, where five used to be claimed and the fifth was
         clipped mid word - the row scrolls either way, and a peek that shows a
         readable half tile says so more clearly than a sliver does.

         The height follows the stack: two lines of name, the Devanagari, and the
         count badge, all at the 18sp floor or above. -->
    <dimen name="subject_tile_width">200dp</dimen>
    <dimen name="subject_tile_height">152dp</dimen>

    <!-- Leanback's own row inset, overridden by name.

         The stock value reserves room for a hero banner this app does not have,
         which left a dead band between the title bar and the first row. Tightened
         so the subject tiles sit near the top where a teacher looks first. -->
    <dimen name="lb_browse_rows_margin_top">96dp</dimen>

    <!-- Rows and row headers start on the same vertical line as the status strip
         above them.

         This is the value behind Leanback's browsePaddingStart attribute, which
         indents both the row header and the row's grid view. It ships at 56dp,
         inside a content frame this app has already inset by the 88dp collapsed
         rail - so rows began at 144dp while the header began at 88 + 48 = 136dp.
         Eight pixels is not much to describe and is immediately obvious as two
         things that were meant to line up and do not. Every column on the browse
         screen now starts at 136dp, the same as every other screen in the app.

         Not lb_browse_rows_margin_start, which is the gutter reserved for the
         header dock and is unused here because headers are disabled. -->
    <dimen name="lb_browse_padding_start">@dimen/overscan_horizontal</dimen>
    <dimen name="lb_browse_padding_end">@dimen/overscan_horizontal</dimen>

    <!-- Row headers at rest. Leanback fades the unselected ones to 50%, which was
         built for white-on-black; on cream it took an already light label down to
         somewhere between the page and nothing, and the row titles effectively
         vanished. The type carries its own hierarchy - it does not need to be
         faded to say it is not the focused row.

         A fraction, not a dimension: that is the type Leanback declares it as,
         and an override under the wrong type is a silent no-op rather than an
         error. -->
    <item name="lb_browse_header_unselect_alpha" type="fraction">100%</item>

    <!-- Utility rail. Collapsed shows glyphs only; focusing it expands over the
         content to reveal labels at a size that reads across a classroom. The
         glyph column is the collapsed width less the rail padding, so the icons
         do not shift when the labels appear. -->
    <!-- 108 = 28 lead + 72 glyph column + 8 trail.

         The lead is what puts the icons past the overscan line. A 28dp icon
         centred in the 72dp column starts 22dp into it, so at the old 8dp lead
         the glyphs began at 30dp - inside the 48dp a cheap panel is entitled to
         crop. The rail's navy still bleeds to x=0, which is right; it was only
         ever the icons that could not afford to be there. -->
    <dimen name="sidebar_collapsed_width">108dp</dimen>
    <dimen name="sidebar_lead">28dp</dimen>
    <dimen name="sidebar_expanded_width">272dp</dimen>
    <dimen name="sidebar_item_height">62dp</dimen>
    <dimen name="sidebar_glyph_column">72dp</dimen>
    <!-- Drawn icons, not font glyphs. The old rail set four Unicode characters
         as text, two of which (U+25C9, U+2699) are routinely missing from the
         font on cheap Amlogic and Allwinner boxes - where the teacher gets a
         tofu box instead of an icon. -->
    <dimen name="sidebar_glyph_size">28dp</dimen>

    <!-- The rail runs full height now and carries the brand at the top, so
         there is no header left to clear. These size that mark: it sits in the
         same 72dp glyph column as the four icons below it, so nothing on the
         left edge moves when the rail opens. -->
    <dimen name="sidebar_brand_top">22dp</dimen>
    <dimen name="sidebar_brand_size">44dp</dimen>

    <!-- The prose pages start their content on one line, under the title, rather
         than each centring its own block in whatever height it happens to have.
         Profile and Downloads were centred and Settings was not, so moving
         between three screens that are otherwise identical moved the first line
         four hundred pixels up the panel. -->
    <dimen name="page_lead">34dp</dimen>

    <!-- Settings draws a card grid, and SettingsCard carries a 10dp margin of
         its own. Taking that back out of the page inset is what puts the outer
         edge of the first card on the same line as the page title above it. -->
    <dimen name="settings_grid_start">38dp</dimen>
</resources>
