<?xml version="1.0" encoding="utf-8"?>
<!-- Lesson poster. Same frame logic as the unit tile, but the focused fill tints
     the information strip under the artwork, which is the only part of the card
     this colour is visible through. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_focus" />
            <stroke android:width="4dp" android:color="@color/focus_gold" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_panel" />
            <stroke android:width="1dp" android:color="@color/hairline" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
