<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_focus" />
            <stroke android:width="3dp" android:color="@color/focus_gold" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_selected" />
            <stroke android:width="1dp" android:color="@color/hairline_strong" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_panel" />
            <stroke android:width="1dp" android:color="@color/hairline" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
