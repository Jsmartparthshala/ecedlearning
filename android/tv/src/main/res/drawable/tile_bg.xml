<?xml version="1.0" encoding="utf-8"?>
<!-- Unit tile. The whole tile is a flat subject colour set at runtime, so this
     drawable is only the frame: a hairline at rest, a thick gold stroke on focus.
     Strokes are effectively free on a Mali-450; glows and elevation are not. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_panel" />
            <stroke android:width="4dp" android:color="@color/focus_gold" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <!-- Selected but not focused: focus has dropped into the lesson grid below.
         The tile still has to say which unit that grid belongs to, so it keeps a
         gold edge, dimmed rather than removed. A hairline is not enough from ten
         feet and the teacher loses track of where they are. -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_panel" />
            <stroke android:width="4dp" android:color="@color/focus_gold_dim" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_panel" />
            <stroke android:width="1dp" android:color="@color/hairline" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
