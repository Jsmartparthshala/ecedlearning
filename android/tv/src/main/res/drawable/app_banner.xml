<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher banner. Android TV shows this in the home row and the app is
     invisible on the launcher without one.

     Navy field here, deliberately, even though the app itself runs on cream.
     The launcher row is a dark strip of other people's artwork; a cream banner
     on it reads as a blank tile, and this is the one surface where the brand has
     to hold its own against whatever Netflix put next to it. Inside the app the
     rule is the opposite and navy stays an accent.

     The emblem is ic_brand_mark under a group transform rather than a second
     copy of the geometry, so the mark can only ever be redrawn in one place.
     The wordmark is stroked with round caps to match the arcs above it - the
     same pen drawing both, which is what stops a mark and its lettering from
     looking like two unrelated files. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="320dp"
    android:height="180dp"
    android:viewportWidth="320"
    android:viewportHeight="180">

    <path
        android:fillColor="@color/brand_navy_deep"
        android:pathData="M0,0h320v180h-320z" />

    <group
        android:scaleX="1.5"
        android:scaleY="1.5"
        android:translateX="44"
        android:translateY="54">
        <path
            android:strokeColor="@color/tv_bg" android:strokeWidth="3.2"
            android:strokeLineCap="round"
            android:pathData="M18.68,20.02 A6.5,6.5 0 0,1 29.32,20.02" />
        <path
            android:strokeColor="@color/tv_bg" android:strokeWidth="3.2"
            android:strokeLineCap="round"
            android:pathData="M14.17,16.86 A12,12 0 0,1 33.83,16.86" />
        <path
            android:strokeColor="@color/tv_bg" android:strokeWidth="3.2"
            android:strokeLineCap="round"
            android:pathData="M9.67,13.71 A17.5,17.5 0 0,1 38.33,13.71" />
        <path
            android:fillColor="@color/tv_bg"
            android:pathData="M23,25.25 C19,22.75 14,22.05 9.5,22.45 L9.5,33.25 C14,32.85 19,33.55 23,35.75 Z" />
        <path
            android:fillColor="@color/tv_bg"
            android:pathData="M25,25.25 C29,22.75 34,22.05 38.5,22.45 L38.5,33.25 C34,32.85 29,33.55 25,35.75 Z" />
    </group>

    <!-- J S P -->
    <path
        android:strokeColor="@color/brand_gold" android:strokeWidth="7"
        android:strokeLineCap="round"
        android:pathData="M169,74 L169,99 A11,11 0 0,1 147,99" />
    <path
        android:strokeColor="@color/brand_gold" android:strokeWidth="7"
        android:strokeLineCap="round"
        android:pathData="M218,83 C218,76 209,73 203,74 C194,75 190,84 198,90 C206,96 216,97 217,104 C218,111 209,114 201,112 C196,111 193,108 192,105" />
    <path
        android:strokeColor="@color/brand_gold" android:strokeWidth="7"
        android:strokeLineCap="round"
        android:pathData="M240,112 L240,74 L254,74 A11,11 0 0,1 254,96 L240,96" />
</vector>
