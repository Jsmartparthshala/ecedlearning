<?xml version="1.0" encoding="utf-8"?>
<!-- The mark on the navy rail. Identical geometry to ic_brand_mark, with figure
     and ground swapped: cream book and arcs, navy play mark and globe lines.

     Two files rather than one tinted file because the globe alternates figure
     and ground three times inside a 9dp disc, and a single even-odd path that
     expresses that is unreadable and unmaintainable. The geometry must stay
     identical between the two - change one, change the other. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="48"
    android:viewportHeight="48">

    <!-- Signal. Three arcs on a common centre at the spine, so it reads as
         arriving at the book rather than floating above it. -->
    <path
        android:strokeColor="@color/tv_bg" android:strokeWidth="2.6"
        android:strokeLineCap="round"
        android:pathData="M19.50,12.84 A5.5,5.5 0 0,1 28.50,12.84" />
    <path
        android:strokeColor="@color/tv_bg" android:strokeWidth="2.6"
        android:strokeLineCap="round"
        android:pathData="M16.22,10.55 A9.5,9.5 0 0,1 31.78,10.55" />
    <path
        android:strokeColor="@color/tv_bg" android:strokeWidth="2.6"
        android:strokeLineCap="round"
        android:pathData="M12.94,8.25 A13.5,13.5 0 0,1 35.06,8.25" />

    <!-- Open book. Straight outer edge, curved inner edge - which is what makes
         a flat shape read as paper under tension instead of two triangles. -->
    <path
        android:fillColor="@color/tv_bg"
        android:pathData="M23,22.5 C18.5,19.6 11,18.8 4.5,19.4 L4.5,38.4 C11,37.8 18.5,38.6 23,41.5 Z" />
    <path
        android:fillColor="@color/tv_bg"
        android:pathData="M25,22.5 C29.5,19.6 37,18.8 43.5,19.4 L43.5,38.4 C37,37.8 29.5,38.6 25,41.5 Z" />

    <!-- Left page: play. -->
    <path
        android:fillColor="@color/brand_navy"
        android:pathData="M11.6,26.3 L17.4,29.5 L11.6,32.7 Z" />

    <!-- Right page: globe. Disc, then meridian and equator drawn back over it in
         the figure colour. Four shapes, because a wireframe globe that is only
         an outline disappears at this size and a solid one is just a dot. -->
    <path
        android:fillColor="@color/brand_navy"
        android:pathData="M29.7,29.5 A4.6,4.6 0 1,0 38.9,29.5 A4.6,4.6 0 1,0 29.7,29.5 Z" />
    <path
        android:fillColor="@color/tv_bg"
        android:pathData="M32.4,29.5 A1.9,4.6 0 1,0 36.2,29.5 A1.9,4.6 0 1,0 32.4,29.5 Z" />
    <path
        android:fillColor="@color/brand_navy"
        android:pathData="M33.4,29.5 A0.9,3.9 0 1,0 35.2,29.5 A0.9,3.9 0 1,0 33.4,29.5 Z" />
    <path
        android:fillColor="@color/tv_bg"
        android:pathData="M29.7,29.5 A4.6,0.55 0 1,0 38.9,29.5 A4.6,0.55 0 1,0 29.7,29.5 Z" />
</vector>
