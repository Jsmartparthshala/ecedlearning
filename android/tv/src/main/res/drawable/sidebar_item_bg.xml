<?xml version="1.0" encoding="utf-8"?>
<!-- Sidebar row. Transparent at rest so the rail reads as one surface, filled and
     ringed on focus. Same stroke-not-glow rule as every other focusable thing
     here: strokes are free on a Mali-450, blurs and elevation are not. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_focus" />
            <stroke android:width="3dp" android:color="@color/focus_gold" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_selected" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
