<?xml version="1.0" encoding="utf-8"?>
<!-- Play mark shown on the focused lesson poster.

     Two tones, and deliberately not tinted by the caller. A poster can be a flat
     subject colour today and a real photographic thumbnail tomorrow, and a bare
     white triangle disappears against a pale frame. The disc gives it something
     to sit on, so the mark reads the same on every poster in the grid.

     Same triangle as ic_nav_videos, scaled onto the same 24dp grid, so the play
     shape is one shape everywhere in the app. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#A6000000"
        android:pathData="M12,0.5 A11.5,11.5 0 1,0 12,23.5 A11.5,11.5 0 1,0 12,0.5 Z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:strokeLineJoin="round"
        android:pathData="M9.4,6.9 L17.4,12 L9.4,17.1 Z" />
</vector>
