<?xml version="1.0" encoding="utf-8"?>
<!-- Focus state lives here so Leanback's focus handling drives it for free.
     A stroke, not a glow or shadow - strokes are effectively free on a Mali-450,
     blurs and elevation are not. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_focus" />
            <stroke android:width="4dp" android:color="@color/focus_gold" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_panel" />
            <stroke android:width="1dp" android:color="@color/hairline" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
