<?xml version="1.0" encoding="utf-8"?>
<!-- The gold focus ring. Leanback handles WHICH item is focused; this is what
     focus looks like. Keep it thick and high-contrast — it has to read from
     across a classroom, not from 60cm away. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_panel" />
            <stroke
                android:width="@dimen/focus_ring_width"
                android:color="@color/focus_gold" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_panel" />
            <stroke android:width="1dp" android:color="@color/hairline" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
