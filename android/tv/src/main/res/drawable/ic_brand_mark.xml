<?xml version="1.0" encoding="utf-8"?>
<!-- The JSP mark, redrawn.

     The supplied artwork was an upscaled raster: a navy roundel holding an open
     book, three broadcast arcs above it, and two small inset glyphs - a play
     triangle on the left page, a globe on the right. Upscaling had left the
     edges soft and the two inset glyphs were already illegible at their original
     size, let alone in a 28dp title bar seen from three metres.

     So this is the mark reduced to the two ideas that survive at that distance:
     an open book, and a signal coming into it. The play triangle and the globe
     are gone - not to simplify for its own sake, but because at the sizes this
     app actually draws the mark they resolve to two grey smudges, and a smudge
     says nothing the book does not already say.

     Geometry, not a trace. Concentric arcs on a common centre at the spine, so
     the signal reads as arriving at the book rather than floating over it. Pure
     vector: no bitmap decode, no memory per draw, and it stays crisp from the
     28dp title bar up to the 320dp launcher banner off one file. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="48"
    android:viewportHeight="48"
    android:tint="@color/brand_navy">

    <!-- Three arcs, radius 6.5 / 12 / 17.5 about the spine at (24, 23.75).
         Stroked rather than filled, with round caps, so each stays an even
         weight and the set reads as one gesture. -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3.2"
        android:strokeLineCap="round"
        android:pathData="M18.68,20.02 A6.5,6.5 0 0,1 29.32,20.02" />
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3.2"
        android:strokeLineCap="round"
        android:pathData="M14.17,16.86 A12,12 0 0,1 33.83,16.86" />
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3.2"
        android:strokeLineCap="round"
        android:pathData="M9.67,13.71 A17.5,17.5 0 0,1 38.33,13.71" />

    <!-- Open book. Two pages curving away from a common spine; the outer edge is
         straight and the inner edge curves, which is what makes a flat shape read
         as paper under tension rather than as two triangles. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M23,25.25 C19,22.75 14,22.05 9.5,22.45 L9.5,33.25 C14,32.85 19,33.55 23,35.75 Z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M25,25.25 C29,22.75 34,22.05 38.5,22.45 L38.5,33.25 C34,32.85 29,33.55 25,35.75 Z" />
</vector>
