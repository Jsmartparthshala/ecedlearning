<?xml version="1.0" encoding="utf-8"?>
<!-- One sidebar entry: a glyph that is always visible, and a label that appears
     only while the rail is expanded.

     The glyph column is exactly the collapsed rail width, so expanding the rail
     reveals the label to the right without the icon moving a pixel. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/sidebar_item_height"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/sidebar_item_bg"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <!-- duplicateParentState, or the glyph and its own label disagree.

         setSelected on a ViewGroup is dispatched down to its children; focus is
         not. So without this the glyph saw selected but never focused, and on
         the row for the screen you are already on it stayed gold while the label
         beside it inverted to navy - two halves of one button in two states. -->
    <ImageView
        android:id="@+id/si_glyph"
        android:layout_width="@dimen/sidebar_glyph_column"
        android:layout_height="@dimen/sidebar_glyph_size"
        android:scaleType="fitCenter"
        android:duplicateParentState="true"
        android:tint="@color/sidebar_glyph"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/si_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:duplicateParentState="true"
        android:textColor="@color/sidebar_glyph"
        android:textSize="@dimen/text_body"
        android:visibility="gone" />
</LinearLayout>
