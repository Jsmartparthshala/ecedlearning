<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="true"
        app:use_controller="true"
        app:show_buffering="when_playing" />

    <!-- Shown only when playback fails.

         Without it a failure is a black screen wearing the stock transport bar,
         reading 01:43 / 00:00 as though it were about to start. Nothing said the
         video had not been reached, OK did nothing, and the only way out was a
         back button nobody was told about. In a classroom that is indistinguishable
         from the television being broken.

         It covers the player rather than sitting beside it, and the controller is
         switched off underneath while it shows, so there is exactly one thing on
         screen saying what happened. -->
    <LinearLayout
        android:id="@+id/player_error"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:background="@color/tv_bg"
        android:paddingStart="@dimen/overscan_horizontal"
        android:paddingEnd="@dimen/overscan_horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/pe_kicker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/text_on_surface_accent"
            android:textSize="@dimen/text_label"
            android:textStyle="bold"
            android:letterSpacing="0.12" />

        <TextView
            android:id="@+id/pe_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/tv_ink"
            android:textSize="@dimen/text_title" />

        <TextView
            android:id="@+id/pe_body"
            android:layout_width="720dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textColor="@color/tv_muted"
            android:textSize="@dimen/text_label"
            android:lineSpacingMultiplier="1.3" />
    </LinearLayout>
</FrameLayout>
