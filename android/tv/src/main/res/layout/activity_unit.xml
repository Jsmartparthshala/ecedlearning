<?xml version="1.0" encoding="utf-8"?>
<!-- Unit detail: a rail of unit tiles over a grid of lesson posters.

     This replaced two stacked lists. Lists are the wrong shape for a remote and
     the wrong shape for video: a list shows six items in the space a grid shows
     ten, and it gives a teacher nothing to recognise except a line of text.
     Everything on this screen is now a thumbnail.

     There are exactly two focus zones, which is what makes it quick on a remote.
     Left and right move along the rail, down drops into the grid, up comes back.
     The rail is focus driven, so arrowing across units rewrites the header and
     reloads the grid without pressing OK; OK on a tile jumps straight into the
     grid rather than opening another screen.

     A focused tile scales to 1.06, so it needs to paint a few pixels outside its
     own slot or the gold ring gets cut in half. That room is padding plus
     clipToPadding, and NOT clipChildren, which used to be off the whole way down.

     clipChildren has to stay on here, on this root, because the flag is read off
     the *parent*: a RecyclerView's own contents are clipped to its bounds by
     whoever contains it, so clipChildren="false" here left the grid free to paint
     anywhere on the screen. Scroll the grid down one row and the row above it
     sits above the grid's top edge - and it was drawn there, straight over the
     unit header and the lower half of the rail. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:clipChildren="true"
    android:background="@color/tv_bg">

    <!-- top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/overscan_horizontal"
        android:paddingEnd="@dimen/overscan_horizontal"
        android:paddingTop="12dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/unit_crumb"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/tv_ink"
            android:textSize="@dimen/text_heading"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/unit_progress_chip"
            style="@style/StatusChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/unit_storage_chip"
            style="@style/StatusChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <TextView
        style="@style/PaneHeading"
        android:layout_marginStart="@dimen/overscan_horizontal"
        android:layout_marginEnd="@dimen/overscan_horizontal"
        android:layout_marginBottom="6dp"
        android:text="@string/pane_units" />

    <!-- unit rail -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/unit_rail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:clipChildren="true"
        android:paddingStart="@dimen/overscan_horizontal"
        android:paddingEnd="@dimen/overscan_horizontal"
        android:paddingTop="@dimen/focus_bleed"
        android:paddingBottom="@dimen/focus_bleed" />

    <!-- Header for the grid below. Written from whichever tile holds focus, so it
         doubles as the label for the rail selection. One line keeps two rows of
         posters on screen at 540dp of layout height. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="bottom"
        android:baselineAligned="false"
        android:paddingStart="@dimen/overscan_horizontal"
        android:paddingEnd="@dimen/overscan_horizontal"
        android:paddingTop="6dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/lesson_kicker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:paddingBottom="3dp"
            android:maxLines="1"
            android:textColor="@color/text_on_surface_accent"
            android:textSize="@dimen/text_label"
            android:textStyle="bold"
            android:letterSpacing="0.12" />

        <TextView
            android:id="@+id/lesson_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/tv_ink"
            android:textSize="@dimen/text_heading"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/lesson_meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:paddingBottom="3dp"
            android:maxLines="1"
            android:textColor="@color/tv_muted"
            android:textSize="@dimen/text_label" />
    </LinearLayout>

    <!-- lesson grid -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/lesson_grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:clipChildren="true"
        android:paddingStart="@dimen/overscan_horizontal"
        android:paddingEnd="@dimen/overscan_horizontal"
        android:paddingTop="@dimen/focus_bleed"
        android:paddingBottom="@dimen/overscan_vertical" />
</LinearLayout>
