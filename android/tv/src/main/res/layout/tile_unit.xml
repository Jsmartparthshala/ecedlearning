<?xml version="1.0" encoding="utf-8"?>
<!-- Unit tile for the horizontal rail.

     No title on the tile itself. The rail is focus driven: whichever unit holds
     focus writes its title, lesson count and running time into the header below,
     so the tile only has to carry the number. That keeps it small enough to fit
     eight units on screen at once, which is the whole point of a rail over a list.

     It used to carry a "UNIT" badge and a video count too, both set at 11sp. The
     badge repeated the word on every tile in a rail of units sitting under a
     header that already says it, and the count repeated what the header prints
     for the focused tile. Neither fits at 18sp in a 132dp tile, and the tile is
     not worth widening for text that says nothing new.

     Nothing here decodes a bitmap. The artwork is a flat solid colour and the
     numeral is text, so a rail of tiles costs a few font lookups. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tile_root"
    android:layout_width="@dimen/unit_tile_width"
    android:layout_height="@dimen/unit_tile_height"
    android:background="@drawable/tile_bg"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <FrameLayout
        android:id="@+id/tu_art"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="4dp">

        <TextView
            android:id="@+id/tu_no"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="@color/on_subject"
            android:textSize="@dimen/text_title"
            android:textStyle="bold" />

        <FrameLayout
            android:id="@+id/tu_track"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_gravity="bottom"
            android:background="@color/badge_scrim"
            android:visibility="gone">

            <View
                android:id="@+id/tu_fill"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:background="@color/brand_navy" />
        </FrameLayout>
    </FrameLayout>
</FrameLayout>
