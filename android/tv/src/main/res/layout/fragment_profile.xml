<?xml version="1.0" encoding="utf-8"?>
<!-- Who this television belongs to.

     Two states, both real, neither a placeholder:

     - a teacher has been assigned from the ops console, so this names them and
       the class they take;
     - no teacher has been assigned, so the television belongs to the school as a
       whole. That is the correct answer for a hall or a shared room, not a
       failure, and it is worded as such.

     There is still no sign in anywhere in this product, by design. The office
     assigns the device to a teacher; the teacher never types a password into a
     television with a remote control. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:paddingStart="@dimen/overscan_horizontal"
    android:paddingEnd="@dimen/overscan_horizontal"
    android:paddingBottom="90dp">

    <TextView
        android:id="@+id/profile_school"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:textColor="@color/text_on_surface_accent"
        android:textSize="@dimen/text_label"
        android:textStyle="bold"
        android:letterSpacing="0.12" />

    <!-- The name, when there is one. Sized like a headline because on this
         screen it IS the headline. -->
    <TextView
        android:id="@+id/profile_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/tv_ink"
        android:textSize="@dimen/text_title" />

    <TextView
        android:id="@+id/profile_role"
        android:layout_width="@dimen/page_measure"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:textColor="@color/tv_muted"
        android:textSize="@dimen/text_label"
        android:lineSpacingMultiplier="1.45" />
</LinearLayout>
