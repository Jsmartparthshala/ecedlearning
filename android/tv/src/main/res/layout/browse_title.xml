<?xml version="1.0" encoding="utf-8"?>
<!-- Custom Leanback title bar. Leanback's default gives you a title and a search
     orb; the prototype's header carries a brand mark on the left and live device
     status on the right, which is most of what makes the screen feel like a
     product rather than a list. -->
<np.com.jagdamba.eced.tv.BrowseTitleView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@color/tv_bg"
    android:paddingStart="@dimen/overscan_horizontal"
    android:paddingEnd="@dimen/overscan_horizontal"
    android:paddingTop="20dp"
    android:paddingBottom="12dp">

    <!-- The real mark, not a Unicode stand-in.

         This was ✦ - U+2726, set as text in gold. Two problems, and the second
         is the serious one. It is 1.51:1 on cream, so it had stopped being
         visible at all; and U+2726 is one of the characters routinely missing
         from the system font on cheap Amlogic and Allwinner boxes, which is
         exactly the hardware this ships on. On those, the brand mark rendered
         as a tofu box. A vector cannot be missing from a font. -->
    <ImageView
        android:id="@+id/title_mark"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:src="@drawable/ic_brand_mark"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/title_brand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:text="@string/app_name"
        android:textColor="@color/tv_ink"
        android:textSize="@dimen/text_heading"
        android:textStyle="bold"
        android:letterSpacing="0.01" />

    <!-- Pushes the status chips to the right edge. -->
    <Space
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/chip_school"
        style="@style/StatusChip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/chip_net"
        style="@style/StatusChip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/chip_update"
        style="@style/StatusChip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/chip_update"
        android:textColor="@color/brand_navy"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/chip_clock"
        style="@style/StatusChip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />
</np.com.jagdamba.eced.tv.BrowseTitleView>
