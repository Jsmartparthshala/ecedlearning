<?xml version="1.0" encoding="utf-8"?>
<!-- Custom Leanback title bar: live device status, right aligned.

     Leanback's default gives you a title and a search orb. This app has no search
     and does not need its own name read back to it on every screen, so the row
     carries the four things a teacher or an operator actually wants from the
     door - which school this box is claimed by, whether it is online, whether an
     update is waiting, and the time.

     The brand used to sit on the left here. It moved into the rail, because the
     header starts at the overscan inset while the rail starts at the screen edge,
     so the mark and the glyphs below it stood on two different vertical lines. -->
<np.com.jagdamba.eced.tv.BrowseTitleView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@color/tv_bg"
    android:paddingStart="@dimen/overscan_horizontal"
    android:paddingEnd="@dimen/overscan_horizontal"
    android:paddingTop="20dp"
    android:paddingBottom="12dp">

    <!-- Holds the row's height steady and pushes the chips to the right edge.
         Without it the strip would collapse to the tallest chip and the first row
         beneath would shift as chips appear and disappear. -->
    <Space
        android:layout_width="0dp"
        android:layout_height="30dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/chip_school"
        style="@style/StatusChip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/chip_net"
        style="@style/StatusChip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/chip_update"
        style="@style/StatusChip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/chip_update"
        android:textColor="@color/brand_navy"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/chip_clock"
        style="@style/StatusChip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />
</np.com.jagdamba.eced.tv.BrowseTitleView>
