<?xml version="1.0" encoding="utf-8"?>
<!-- Subject tile for the home screen, and the grade tiles in the row below it.

     Bigger than a unit poster and carrying the subject name rather than a number,
     because this is the first choice a teacher makes and the only one where the
     word matters more than the position. Same anatomy as the unit tile so the two
     screens read as one product: flat subject fill, badge bottom left, gold ring
     on focus.

     The three lines are stacked in a bottom-anchored column rather than each
     being positioned with its own bottom margin. The old version pinned all three
     to the bottom of the frame and spaced them by hand, which meant every change
     to a text size had to be paid for again in three margins - and a subject whose
     name wrapped to two lines pushed its own Nepali line underneath itself. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/subject_root"
    android:layout_width="@dimen/subject_tile_width"
    android:layout_height="@dimen/subject_tile_height"
    android:background="@drawable/tile_bg"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <FrameLayout
        android:id="@+id/cs_art"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/cs_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:ellipsize="end"
                android:textColor="@color/on_subject"
                android:textSize="@dimen/text_heading"
                android:textStyle="bold"
                android:lineSpacingMultiplier="1.05" />

            <!-- The Nepali name has been in the database since the first schema
                 and has never once been on screen. These are Nepali schools; the
                 Devanagari is the name a teacher recognises fastest, and the
                 English above it is the one the curriculum documents use. Hidden
                 rather than blank when a subject has no Nepali name yet, so a
                 half-translated catalogue does not leave gaps in the row. -->
            <TextView
                android:id="@+id/cs_name_np"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:alpha="0.82"
                android:textColor="@color/on_subject"
                android:textSize="@dimen/text_label" />

            <TextView
                android:id="@+id/cs_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:background="@color/badge_scrim"
                android:textColor="@color/on_subject"
                android:textSize="@dimen/text_label" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
