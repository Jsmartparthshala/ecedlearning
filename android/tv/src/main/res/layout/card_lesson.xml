<?xml version="1.0" encoding="utf-8"?>
<!-- Card anatomy follows the prototype: coloured artwork panel on top, dark
     information strip below.

     Cost notes for Mali-450-class hardware — a small linear gradient over a
     280x158 card is cheap (it is the full-screen backdrop crossfade that is not),
     and the big glyph is font rendering rather than a bitmap decode, so nothing
     here allocates memory per card. Overdraw stays at 1x: the artwork panel and
     the info strip do not overlap. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card_root"
    android:layout_width="280dp"
    android:layout_height="188dp"
    android:orientation="vertical"
    android:background="@drawable/card_bg"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <!-- Artwork. Background is set at runtime from the subject's two colours. -->
    <!-- Inset, like the artwork on every other card in the app.

         The focus stroke is drawn by the root's own background, so it lands
         behind the children. With the artwork flush to the edge it painted over
         the top of that stroke and both upper sides, and a focused Continue
         watching card came up wearing three quarters of a gold ring - which
         reads as a rendering fault rather than as focus. tile_unit, card_subject
         and poster_lesson all inset their artwork for this reason; this one did
         not. No bottom margin, so the progress scrubber still sits flush under
         the picture. -->
    <FrameLayout
        android:id="@+id/card_art"
        android:layout_width="match_parent"
        android:layout_height="104dp"
        android:layout_marginStart="4dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="4dp">

        <!-- Poster frame, when the lesson has one. First child so it sits behind
             the glyph and badges; empty and invisible otherwise, which leaves the
             subject colour showing exactly as before. -->
        <ImageView
            android:id="@+id/card_poster"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@null" />

        <!-- White text over an arbitrary video frame is unreadable about half the
             time. This darkens the frame enough to carry the glyph and badges
             without hiding what the picture is. -->
        <View
            android:id="@+id/card_poster_scrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/poster_scrim"
            android:visibility="gone" />

        <TextView
            android:id="@+id/card_glyph"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="@color/on_subject"
            android:alpha="0.92"
            android:textSize="@dimen/text_display"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/card_kicker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="10dp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:background="@color/badge_scrim"
            android:textColor="@color/on_subject"
            android:textSize="@dimen/text_label"
            android:letterSpacing="0.08"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/card_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="10dp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:background="@color/badge_scrim"
            android:textColor="@color/on_subject"
            android:textSize="@dimen/text_label" />
    </FrameLayout>

    <!-- Watch progress sits directly under the artwork, like a video scrubber. -->
    <FrameLayout
        android:id="@+id/card_progress_track"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:background="@color/hairline"
        android:visibility="gone">

        <View
            android:id="@+id/card_progress_fill"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="@color/brand_navy" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/card_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:ellipsize="end"
            android:duplicateParentState="true"
            android:textColor="@color/text_on_surface"
            android:textSize="@dimen/text_body" />

        <TextView
            android:id="@+id/card_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:duplicateParentState="true"
            android:textColor="@color/text_on_surface_muted"
            android:textSize="@dimen/text_label" />
    </LinearLayout>
</LinearLayout>
