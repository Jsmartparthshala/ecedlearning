<?xml version="1.0" encoding="utf-8"?>
<!-- Card anatomy follows the prototype: coloured artwork panel on top, dark
     information strip below.

     Cost notes for Mali-450-class hardware — a small linear gradient over a
     280x158 card is cheap (it is the full-screen backdrop crossfade that is not),
     and the big glyph is font rendering rather than a bitmap decode, so nothing
     here allocates memory per card. Overdraw stays at 1x: the artwork panel and
     the info strip do not overlap. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card_root"
    android:layout_width="280dp"
    android:layout_height="188dp"
    android:orientation="vertical"
    android:background="@drawable/card_bg"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <!-- Artwork. Background is set at runtime from the subject's two colours. -->
    <FrameLayout
        android:id="@+id/card_art"
        android:layout_width="match_parent"
        android:layout_height="104dp">

        <TextView
            android:id="@+id/card_glyph"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="@color/on_subject"
            android:alpha="0.92"
            android:textSize="44sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/card_kicker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="10dp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:background="@color/badge_scrim"
            android:textColor="@color/on_subject"
            android:textSize="12sp"
            android:letterSpacing="0.08"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/card_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="10dp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:background="@color/badge_scrim"
            android:textColor="@color/on_subject"
            android:textSize="12sp" />
    </FrameLayout>

    <!-- Watch progress sits directly under the artwork, like a video scrubber. -->
    <FrameLayout
        android:id="@+id/card_progress_track"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:background="@color/hairline"
        android:visibility="gone">

        <View
            android:id="@+id/card_progress_fill"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="@color/focus_gold" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/card_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:ellipsize="end"
            android:textColor="@color/tv_ink"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/card_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/tv_muted"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
