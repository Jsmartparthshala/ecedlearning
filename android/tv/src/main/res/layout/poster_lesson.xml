<?xml version="1.0" encoding="utf-8"?>
<!-- Lesson poster for the grid.

     Width is match_parent because GridLayoutManager owns the column width; the
     gaps come from an ItemDecoration rather than margins so the outer edges stay
     flush with the overscan padding.

     Anatomy follows the prototype card: artwork panel on top carrying the number
     and the running time, a watch progress scrubber directly beneath it, then a dark
     information strip. The artwork and the strip do not overlap, so overdraw
     stays at 1x. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/poster_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/poster_bg"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <FrameLayout
        android:id="@+id/pl_art"
        android:layout_width="match_parent"
        android:layout_height="@dimen/poster_art_height"
        android:layout_margin="3dp">

        <!-- Poster frame, when the lesson has one. First child so it sits behind
             the number and badges; empty otherwise, leaving the subject colour. -->
        <ImageView
            android:id="@+id/pl_poster"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@null" />

        <View
            android:id="@+id/pl_scrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/poster_scrim"
            android:visibility="gone" />

        <TextView
            android:id="@+id/pl_no"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="@color/on_subject"
            android:alpha="0.92"
            android:textSize="@dimen/text_title"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/pl_dur"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="7dp"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:background="@color/badge_scrim"
            android:textColor="@color/on_subject"
            android:textSize="@dimen/text_label" />

        <!-- Play chevron. Shown only on the focused poster: a play mark on every
             card is noise, on the focused one it says what OK will do. -->
        <ImageView
            android:id="@+id/pl_play"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_play"
            android:importantForAccessibility="no"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/pl_track"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_gravity="bottom"
            android:background="@color/badge_scrim"
            android:visibility="gone">

            <View
                android:id="@+id/pl_fill"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:background="@color/focus_gold" />
        </FrameLayout>
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="10dp"
        android:paddingTop="5dp"
        android:paddingBottom="7dp">

        <TextView
            android:id="@+id/pl_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/tv_ink"
            android:textSize="@dimen/text_body"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/pl_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/tv_muted"
            android:textSize="@dimen/text_label" />
    </LinearLayout>
</LinearLayout>
