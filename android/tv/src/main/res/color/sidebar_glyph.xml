<?xml version="1.0" encoding="utf-8"?>
<!-- The rail glyph. Gold marked the current page on the dark palette; on a white
     rail gold measures 1.5:1 and simply is not there, so the current page is
     marked in brand navy instead, and the focused row - which fills navy - takes
     a cream glyph so it does not disappear into its own background. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:color="@color/on_focus" />
    <item android:state_selected="true" android:color="@color/brand_navy" />
    <item android:color="@color/tv_muted" />
</selector>
