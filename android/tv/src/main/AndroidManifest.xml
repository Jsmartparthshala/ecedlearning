<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Reads the connected band (2.4 / 5 / 6 GHz) for the header chip. Normal
         permission, granted at install; it cannot change the band, only report
         it - no app can change it. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- Required for the OTA module later. Android 12+ always shows a system
         install prompt; a fully silent install is not possible without
         device-owner provisioning. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Leanback is requested, NOT required.
         Marking it required makes Play Store hide the app from every device that
         is not a certified Android TV — which excludes the generic AOSP boxes and
         no-name smart TVs that make up much of the target market. The app degrades
         fine without it: Leanback is a UI library, not a platform dependency. -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <!-- Some cheap boxes report no D-pad even though the bundled IR remote sends
         D-pad events. Requiring it would filter those devices out. -->
    <uses-feature
        android:name="android.hardware.gamepad"
        android:required="false" />

    <application
        android:name=".EcedApp"
        android:allowBackup="false"
        android:banner="@drawable/app_banner"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.Eced.Tv">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize">
            <!-- BOTH launcher categories, deliberately.

                 LEANBACK_LAUNCHER puts the app on the Android TV home row on
                 certified devices. But a generic AOSP box has no Leanback
                 launcher, and an app declaring only that category is completely
                 invisible there - not in the drawer, not searchable, nothing.
                 Adding LAUNCHER costs nothing on real Android TV and is the
                 difference between installable and unusable on the cheap
                 hardware this ships to. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".UnitActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize" />

        <activity
            android:name=".PageActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize" />

        <activity
            android:name=".PlayerActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|smallestScreenSize" />

        <!-- Hands a downloaded APK to the system package installer. A file://
             URI throws FileUriExposedException on anything since Nougat, so the
             OTA path has to go through a provider.
             exported=false with grantUriPermissions: the installer gets read
             access to the one URI it is handed, and nothing else gets anything. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
