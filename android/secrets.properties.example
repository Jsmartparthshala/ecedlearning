# Copy to secrets.properties and fill in from Supabase → Project Settings → API.
# secrets.properties is gitignored. The anon key is safe to ship in an APK
# (RLS is what protects you); the service_role key must NEVER appear here.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJ...

# ---------------------------------------------------------------- release key
# Only needed to build a signed release APK. Leave these out and the release
# build still compiles, it just comes out unsigned and cannot be installed.
#
# Generate the keystore yourself and keep it off this machine's git history:
#
#   keytool -genkeypair -v -keystore jsp-release.jks -alias jsp \
#     -keyalg RSA -keysize 4096 -validity 10000 \
#     -dname "CN=Jagdamba Smart Pathshala, O=Jagdamba Smart Pathshala, C=NP"
#
# RELEASE_STORE_FILE is resolved relative to the android/ directory. Put the
# .jks somewhere gitignored - android/keystore/ is, via the *.jks rule.
#
# Losing this file or its password is not recoverable. Every television already
# in a school would have to be uninstalled and paired again by hand, because an
# in-place update only installs when the signature matches.
#RELEASE_STORE_FILE=jsp-release.jks
#RELEASE_STORE_PASSWORD=
#RELEASE_KEY_ALIAS=jsp
#RELEASE_KEY_PASSWORD=
